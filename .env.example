# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/almost_db?schema=public"

# AI Provider ("mock" | "openai" | "ollama" | "groq")
# Leave as "mock" for zero-cost, zero-API-key local simulation
AI_PROVIDER="mock"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Image Provider ("mock" | "remote-api")
IMAGE_PROVIDER="mock"
IMAGE_BASE_URL=""
IMAGE_API_KEY=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
